# Generate two different values: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
AUDIT_KEY=
APP_ENV=development
DATABASE_PATH=instance/commonroom.db
DEMO_ENABLED=true
# Production requires HTTPS, explicit hosts, and demo disabled.
TRUSTED_HOSTS=localhost,127.0.0.1
PUBLIC_ORIGIN=http://localhost:8000
TRUST_PROXY=false
# Optional account recovery. SMTP uses STARTTLS, never plaintext authentication.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
